# Gemini API Key (get from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AQ.Ab8RN6L-on_Z6zavCDXcBzNEj94pCVM6WTZgE5RQlhICjoyKKQ"

# The channel ID to monitor (your own channel ID)
# Easiest way to find it is to go to your channel on YouTube, click on "About" or your channel link
# Alternatively, use this tool to find it: https://commentpicker.com/youtube-channel-id.php
YOUTUBE_CHANNEL_ID="UCbUGe-amo-6y2qxeWjoAQ-g"

# How often to check for new videos (in seconds)
# 300 seconds = 5 minutes
POLL_INTERVAL_SECONDS=300

# Optional: Set this to true to only generate but NOT update YouTube (for testing)
# Change to 'false' when you are ready to update real videos!
DRY_RUN=true
